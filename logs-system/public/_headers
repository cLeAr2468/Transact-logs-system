# Cache control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# No cache for HTML files to ensure fresh content
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# No cache for service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Main index
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
